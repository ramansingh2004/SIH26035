{
  "$defs": {
    "ChecklistDefinition": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "maxLength": 100,
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "title": "Key",
          "type": "string"
        },
        "group": {
          "enum": [
            "GENERAL",
            "DIRECT_SALES",
            "ELECTRONIC",
            "SOFTWARE_CONTROLLED"
          ],
          "title": "Group",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "applicability": {
          "const": "TODO_REGULATORY_VALIDATION",
          "default": "TODO_REGULATORY_VALIDATION",
          "title": "Applicability",
          "type": "string"
        },
        "evidence_required": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Required"
        },
        "verification": {
          "$ref": "#/$defs/Verification",
          "default": {
            "status": "TODO_REGULATORY_VALIDATION",
            "verified_by": null,
            "verified_at": null,
            "evidence": null
          }
        }
      },
      "required": [
        "key",
        "group",
        "text",
        "source"
      ],
      "title": "ChecklistDefinition",
      "type": "object"
    },
    "Metadata": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "standard_code": {
          "const": "OIML_R76",
          "title": "Standard Code",
          "type": "string"
        },
        "standard_name": {
          "title": "Standard Name",
          "type": "string"
        },
        "edition": {
          "title": "Edition",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        },
        "standard_parts": {
          "items": {
            "$ref": "#/$defs/Source"
          },
          "title": "Standard Parts",
          "type": "array"
        },
        "supported_test_codes": {
          "items": {
            "maxLength": 100,
            "pattern": "^[A-Z][A-Z0-9_]*$",
            "type": "string"
          },
          "title": "Supported Test Codes",
          "type": "array"
        },
        "source_reference": {
          "title": "Source Reference",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "standard_code",
        "standard_name",
        "edition",
        "version",
        "standard_parts",
        "supported_test_codes",
        "source_reference"
      ],
      "title": "Metadata",
      "type": "object"
    },
    "Parameter": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 100,
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "numeric": {
          "default": false,
          "title": "Numeric",
          "type": "boolean"
        }
      },
      "required": [
        "name"
      ],
      "title": "Parameter",
      "type": "object"
    },
    "Rule": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "maxLength": 100,
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "title": "Key",
          "type": "string"
        },
        "section": {
          "anyOf": [
            {
              "maximum": 17,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "verification": {
          "$ref": "#/$defs/Verification",
          "default": {
            "status": "TODO_REGULATORY_VALIDATION",
            "verified_by": null,
            "verified_at": null,
            "evidence": null
          }
        },
        "dependencies": {
          "default": [],
          "items": {
            "maxLength": 100,
            "pattern": "^[A-Z][A-Z0-9_]*$",
            "type": "string"
          },
          "title": "Dependencies",
          "type": "array"
        },
        "blockers": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Blockers",
          "type": "array"
        },
        "parameters": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Parameter"
          },
          "title": "Parameters",
          "type": "array"
        }
      },
      "required": [
        "key",
        "kind",
        "description",
        "source"
      ],
      "title": "Rule",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "part": {
          "title": "Part",
          "type": "string"
        },
        "edition": {
          "title": "Edition",
          "type": "string"
        },
        "identity": {
          "title": "Identity",
          "type": "string"
        },
        "clause": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clause"
        },
        "digest": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Digest"
        }
      },
      "required": [
        "part",
        "edition",
        "identity"
      ],
      "title": "Source",
      "type": "object"
    },
    "TestDefinition": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 100,
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "title": "Code",
          "type": "string"
        },
        "section": {
          "maximum": 17,
          "minimum": 1,
          "title": "Section",
          "type": "integer"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "parent": {
          "anyOf": [
            {
              "maxLength": 100,
              "pattern": "^[A-Z][A-Z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent"
        },
        "family": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Family"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "dependencies": {
          "items": {
            "maxLength": 100,
            "pattern": "^[A-Z][A-Z0-9_]*$",
            "type": "string"
          },
          "title": "Dependencies",
          "type": "array"
        },
        "applicability": {
          "const": "TODO_REGULATORY_VALIDATION",
          "default": "TODO_REGULATORY_VALIDATION",
          "title": "Applicability",
          "type": "string"
        },
        "implemented": {
          "const": false,
          "default": false,
          "title": "Implemented",
          "type": "boolean"
        },
        "verification": {
          "$ref": "#/$defs/Verification",
          "default": {
            "status": "TODO_REGULATORY_VALIDATION",
            "verified_by": null,
            "verified_at": null,
            "evidence": null
          }
        }
      },
      "required": [
        "code",
        "section",
        "name",
        "source",
        "dependencies"
      ],
      "title": "TestDefinition",
      "type": "object"
    },
    "Verification": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "default": "TODO_REGULATORY_VALIDATION",
          "enum": [
            "TODO_REGULATORY_VALIDATION",
            "VERIFIED"
          ],
          "title": "Status",
          "type": "string"
        },
        "verified_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verified By"
        },
        "verified_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verified At"
        },
        "evidence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence"
        }
      },
      "title": "Verification",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "metadata": {
      "$ref": "#/$defs/Metadata"
    },
    "rules": {
      "items": {
        "$ref": "#/$defs/Rule"
      },
      "title": "Rules",
      "type": "array"
    },
    "tests": {
      "items": {
        "$ref": "#/$defs/TestDefinition"
      },
      "title": "Tests",
      "type": "array"
    },
    "checklist": {
      "items": {
        "$ref": "#/$defs/ChecklistDefinition"
      },
      "title": "Checklist",
      "type": "array"
    }
  },
  "required": [
    "metadata",
    "rules",
    "tests",
    "checklist"
  ],
  "title": "RuleSet",
  "type": "object"
}
