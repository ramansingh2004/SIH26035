APP_NAME=SIH26035 API
ENVIRONMENT=development

# Generate a private value: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=<generated-secret-at-least-32-bytes>
ACCESS_TOKEN_SECONDS=900
REFRESH_TOKEN_DAYS=7
REFRESH_FAMILY_DAYS=30
COOKIE_SECURE=true
# For local HTTP only, explicitly set COOKIE_SECURE=false in your private .env.
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
LOGIN_LIMIT=10
LOGIN_WINDOW_SECONDS=300
# Phase 0 /health does not require a database connection.
# Configure this only when using Alembic against your own PostgreSQL instance.
# DATABASE_URL=postgresql+asyncpg://sih26035:change-me@localhost:5432/sih26035

# Phase 3: private, versioned object storage. No public bucket or client storage keys.
STORAGE_PROVIDER=minio
# STORAGE_ENDPOINT=http://127.0.0.1:9000
# STORAGE_BUCKET=sih-phase3-development-dev
# STORAGE_ACCESS_KEY=<private-development-access-key>
# STORAGE_SECRET_KEY=<private-development-secret-key>
STORAGE_REGION=us-east-1
STORAGE_URL_SECONDS=300
# S3: STORAGE_PROVIDER=s3; omit STORAGE_ENDPOINT for the AWS service endpoint.
# See PHASE3_SETUP.md for fresh PostgreSQL/MinIO acceptance setup on Windows.
