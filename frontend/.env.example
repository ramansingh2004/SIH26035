# Local development: browser calls FastAPI directly.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Vercel production:
# Use same-origin browser requests and let Next.js transparently proxy /api/v1/*.
# NEXT_PUBLIC_API_BASE_URL=/
#
# Server-side/build-time only. Do NOT prefix this with NEXT_PUBLIC_.
# BACKEND_API_ORIGIN=https://your-render-service.onrender.com
